{
  "name": "excalidraw-server",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted backend for the intranet fork: Keycloak SSO, storage and realtime collaboration",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:elements": "node ./scripts/build-elements.mjs",
    "prebuild": "yarn build:elements",
    "build": "node ./scripts/build.mjs",
    "predev": "yarn build:elements",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server.mjs",
    "migrate": "node dist/server.mjs migrate",
    "pretest": "yarn build:elements",
    "test": "vitest run --config ./vitest.config.mts",
    "pree2e": "yarn build:elements",
    "e2e": "vitest run --config ./vitest.e2e.config.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/e2e/tsconfig.json",
    "font-metrics": "node ./scripts/font-metrics.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@socket.io/postgres-adapter": "0.5.0",
    "aws4fetch": "1.0.20",
    "fastify": "5.12.8",
    "fflate": "0.8.2",
    "jose": "6.2.17",
    "kysely": "0.29.8",
    "nodemailer": "6.9.16",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.23.1",
    "playwright": "1.58.2",
    "socket.io-client": "4.7.2",
    "tsx": "4.23.15"
  }
}

MODE="production"

# Intranet fork: every URL points to our own backend (excalidraw-server) on
# the same origin. Nothing in this file may point to the internet.

# share links ("#json=..."), same protocol as json.excalidraw.com/api/v2
VITE_APP_BACKEND_V2_GET_URL=/api/v2/
VITE_APP_BACKEND_V2_POST_URL=/api/v2/post/

# public library catalog (libraries.excalidraw.com) is not available;
# empty hides "browse libraries" and "publish library"
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# no font fallback to the esm.sh CDN; fonts are served by the app
VITE_APP_ASSETS_FALLBACK_URL=

# AI features are switched on by the server's runtime config (later phase)
VITE_APP_AI_BACKEND=/api/ai

# collaboration WebSocket server; empty = same origin
VITE_APP_WS_SERVER_URL=

VITE_APP_ENABLE_TRACKING=false

# internal Sentry/GlitchTip only; empty = no error reporting
VITE_APP_SENTRY_DSN=

# Set the below flags explicitly to false in production mode since vite loads and merges .env.local vars when  running the build command
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
# Enable eslint in dev server
VITE_APP_ENABLE_ESLINT=false
